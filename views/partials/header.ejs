<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Eco-Adventure Wildlife Park - habitats, exhibits and outdoor experiences for the whole family.">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Eco-Adventure Wildlife Park' %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <header class="site-hero" style="<%= typeof heroImage !== 'undefined' ? `background-image: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.55)), url(${heroImage});` : '' %>">
        <div class="hero-inner">
            <h1 class="hero-title"><%= typeof heroTitle !== 'undefined' ? heroTitle : 'Eco-Adventure Wildlife Park' %></h1>
            <% if (typeof heroSubtitle !== 'undefined') { %>
                <p class="hero-subtitle"><%= heroSubtitle %></p>
            <% } %>
        </div>
    </header>

    <nav class="site-nav" aria-label="Main navigation">
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/habitats">Habitats</a></li>
            <li><a href="/faq">FAQ</a></li>
            <li><a href="/contact">Contact</a></li>
        </ul>
    </nav>

    <div class="opening-banner" role="note">
        <strong>Open every day:</strong> 9am - 6pm
    </div>

    <main class="site-main">
