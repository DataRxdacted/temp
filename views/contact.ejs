<%- include('partials/header', {
    pageTitle: 'Contact - Eco-Adventure Wildlife Park',
    heroTitle: 'Get in touch',
    heroSubtitle: 'Questions, feedback or schools enquiries',
    heroImage: '/images/hero-contact.jpg'
}) %>

<section class="page-content">

    <% if (submitted) { %>
        <div class="alert alert--success" role="status">
            <h2>Message received!</h2>
            <p>Thanks for getting in touch - we'll reply by email within a couple of working days.</p>
            <p><a href="/">Back to the home page</a></p>
        </div>
    <% } else { %>

        <p class="lead">Fill in the form below and we'll get back to you. All fields are required.</p>

        <% if (errors && errors.length > 0) { %>
            <div class="alert alert--error" role="alert">
                <strong>Please fix the following:</strong>
                <ul>
                    <% errors.forEach(function(e) { %>
                        <li><%= e %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>

        <form id="contactForm" method="POST" action="/contact" novalidate>

            <div class="form-row">
                <label for="name">Your name</label>
                <input type="text" id="name" name="name" required minlength="2" maxlength="100">
                <span class="field-error" id="name-error"></span>
            </div>

            <div class="form-row">
                <label for="email">Email address</label>
                <input type="email" id="email" name="email" required maxlength="200">
                <span class="field-error" id="email-error"></span>
            </div>

            <div class="form-row">
                <label for="subject">Subject</label>
                <input type="text" id="subject" name="subject" required minlength="3" maxlength="200">
                <span class="field-error" id="subject-error"></span>
            </div>

            <div class="form-row">
                <label for="message">Your message</label>
                <textarea id="message" name="message" rows="6" required minlength="10" maxlength="2000"></textarea>
                <span class="field-error" id="message-error"></span>
            </div>

            <button type="submit" class="btn-primary">Send message</button>

        </form>

        <script src="/js/form-validation.js"></script>

    <% } %>

</section>

<%- include('partials/footer') %>
